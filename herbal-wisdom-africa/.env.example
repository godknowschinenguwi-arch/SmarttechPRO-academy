# HMAC secret used to sign session cookies — set a long random value in production.
AUTH_SECRET=

# Local dev uses a file-based SQLite db at prisma/dev.db by default.
# For production, point at Turso/libsql:
# DATABASE_URL=libsql://<db>.turso.io
# DATABASE_AUTH_TOKEN=
DATABASE_URL=
DATABASE_AUTH_TOKEN=
